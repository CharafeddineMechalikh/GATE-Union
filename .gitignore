# Third-party sources are fetched by scripts/fetch_sources.sh into external/raw/.
# They are licence-sensitive and must never be committed wholesale here.
external/raw/
external/cache/

# Large derived artifacts stay out until the redistribution audit passes.
harmonized/vectors/
results/*.log
splits/__pycache__/
__pycache__/
*.pyc
# Scratch run logs stay local and are never published.
*.log

# Local scratch scripts and run output (kept on disk, never published)
_tmp_*
*.npy
*.bat
/run_out.txt
/run_union_output.txt
/analysis_alignment_out.txt
